{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window controls and events for the app: the dev server, the startup splash, and (packaged) the bundled server on 127.0.0.1",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-internal-toggle-maximize"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  }
}
